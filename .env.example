APP_LOG_LEVEL=INFO

MIC_SAMPLE_RATE=16000
MIC_CHANNELS=1
MIC_BLOCK_MS=100
VOICE_ACTIVITY_THRESHOLD=550
VOICE_SILENCE_SECONDS=1.0
VOICE_MAX_RECORD_SECONDS=12
WAIT_FOR_SPEECH_SECONDS=0

SONIOX_API_KEY=replace-with-soniox-api-key
SONIOX_MODEL=stt-rt-v5
SONIOX_WEBSOCKET_URL=wss://stt-rt.soniox.com/transcribe-websocket
SONIOX_MAX_ENDPOINT_DELAY_MS=1500
SONIOX_KEEPALIVE_SECONDS=8
SONIOX_SESSION_RETRY_ATTEMPTS=6
SONIOX_SESSION_RETRY_DELAY_SECONDS=1.0
SONIOX_SESSION_MAX_RETRY_DELAY_SECONDS=8.0
STT_STREAM_CHUNK_MS=100

GEMMA_RESPONSE_BASE_URL=http://43.242.226.49:8100/v1
GEMMA_RESPONSE_API_KEY=
GEMMA_MODEL=replace-with-gemma-model
GEMMA_TEMPERATURE=0.0
GEMMA_MAX_TOKENS=128
GEMMA_REQUEST_TIMEOUT_SECONDS=45
SESSION_STATE_FILE=.session_languages.json
SESSION_JOIN_WINDOW_SECONDS=300

TTS_PROVIDER=google
GOOGLE_TTS_CREDENTIALS_PATH=instas-ai.json
GOOGLE_TTS_SPEAKING_RATE=1.0
GOOGLE_TTS_PITCH=0.0
GOOGLE_TTS_REQUEST_TIMEOUT_SECONDS=20

CARTESIA_API_KEY=replace-with-cartesia-api-key
CARTESIA_API_URL=https://api.cartesia.ai
CARTESIA_WEBSOCKET_URL=wss://api.cartesia.ai/tts/websocket
CARTESIA_VERSION=2026-03-01
CARTESIA_REQUEST_TIMEOUT_SECONDS=60
CARTESIA_SPEED=0.9
CARTESIA_CONTEXT_PREFIX=pi-translator
CARTESIA_EMOTIONS=positivity:high,curiosity:high

CHANNEL_1_NAME=Person 1
CHANNEL_1_SOURCE_LANGUAGE=en
CHANNEL_1_LANGUAGE_MODE=auto
CHANNEL_1_INPUT_SAMPLE_RATE=
CHANNEL_1_SONIOX_LANGUAGE_HINTS=hi,bn,ta,te,gu,kn,ml,mr,pa
CHANNEL_1_CARTESIA_VOICE_ID=replace-with-cartesia-en-voice-id
CHANNEL_1_CARTESIA_MODEL_ID=sonic-3
CHANNEL_1_CARTESIA_SAMPLE_RATE=24000
CHANNEL_1_GOOGLE_TTS_LANGUAGE_CODE=
CHANNEL_1_GOOGLE_TTS_VOICE_NAME=
CHANNEL_1_GOOGLE_TTS_VOICE_GENDER=NEUTRAL
CHANNEL_1_GOOGLE_TTS_SAMPLE_RATE=24000
CHANNEL_1_TRANSLATION_HINT=Keep it natural and conversational for live spoken audio.
CHANNEL_1_INPUT_DEVICE=
CHANNEL_1_OUTPUT_DEVICE=

CHANNEL_2_NAME=Person 2
CHANNEL_2_SOURCE_LANGUAGE=hi
CHANNEL_2_LANGUAGE_MODE=auto
CHANNEL_2_INPUT_SAMPLE_RATE=
CHANNEL_2_SONIOX_LANGUAGE_HINTS=hi,bn,ta,te,gu,kn,ml,mr,pa
CHANNEL_2_CARTESIA_VOICE_ID=replace-with-cartesia-hi-voice-id
CHANNEL_2_CARTESIA_MODEL_ID=sonic-3
CHANNEL_2_CARTESIA_SAMPLE_RATE=24000
CHANNEL_2_GOOGLE_TTS_LANGUAGE_CODE=
CHANNEL_2_GOOGLE_TTS_VOICE_NAME=
CHANNEL_2_GOOGLE_TTS_VOICE_GENDER=NEUTRAL
CHANNEL_2_GOOGLE_TTS_SAMPLE_RATE=24000
CHANNEL_2_TRANSLATION_HINT=Keep it natural and conversational for live spoken audio.
CHANNEL_2_INPUT_DEVICE=
CHANNEL_2_OUTPUT_DEVICE=
