# Backend configuration. Replace placeholders in Render's backend Environment tab.
# Never put provider keys, JWT_SECRET or DATABASE_URL in VITE_* variables.
APP_LOG_LEVEL=INFO
HOST=0.0.0.0
# Local port; on Render let the platform supply PORT.
PORT=8765
DATABASE_URL=
# Required on Render: unique random secret, at least 32 characters.
JWT_SECRET=

TRANSLATION_PROVIDER=soniox
SONIOX_API_KEY=your_soniox_api_key_here
SONIOX_MODEL=stt-rt-v5
SONIOX_WEBSOCKET_URL=wss://stt-rt.soniox.com/transcribe-websocket
SONIOX_MAX_ENDPOINT_DELAY_MS=1000
SONIOX_KEEPALIVE_SECONDS=8
SONIOX_SESSION_RETRY_ATTEMPTS=1
STT_STREAM_CHUNK_MS=100

TTS_PROVIDER=cartesia
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=95d51f79-c397-46f9-b49a-23763d3eaa2d
CARTESIA_MODEL_ID=sonic-3.6-2026-08-27
CARTESIA_VERSION=2026-08-14
CARTESIA_WEBSOCKET_URL=wss://api.cartesia.ai/tts/websocket
CARTESIA_REQUEST_TIMEOUT_SECONDS=15
CARTESIA_SAMPLE_RATE=24000
CARTESIA_SPEED=1.0
CARTESIA_EMOTIONS=
# Optional JSON language-to-voice overrides, e.g. {"hi":"voice-id","en":"voice-id"}.
CARTESIA_VOICE_MAP={}

# Set to your frontend HTTPS origin to restrict browser access; * permits bearer-authenticated clients.
CORS_ORIGINS=*
# Native translation uses one stream per speaker/target language, shared among listeners.
REALTIME_MAX_LANGUAGES=4
