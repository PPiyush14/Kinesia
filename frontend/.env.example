# Kinesia Frontend Environment Configuration
# When running locally with the Vite dev server proxy to localhost:8765, leave blank.
# On the Render frontend, set this BUILD-TIME variable to your backend HTTPS URL.
# The same base URL is used for REST and wss:// room audio connections.
# No trailing /api path. Never put API keys or the database URL in this file.
# VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_BASE_URL=
