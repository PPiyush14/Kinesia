APP_LOG_LEVEL=INFO

# AI Engine — Groq Cloud (Ultra-fast LLM translation)
GEMMA_RESPONSE_BASE_URL=https://api.groq.com/openai/v1
GEMMA_RESPONSE_API_KEY=gsk_your_groq_api_key_here
GEMMA_MODEL=qwen/qwen3.8-27b
GEMMA_TEMPERATURE=0.0
GEMMA_MAX_TOKENS=256
GEMMA_REQUEST_TIMEOUT_SECONDS=30

# Speech-to-Text (STT) Engine — Soniox STT
SONIOX_API_KEY=your_soniox_api_key_here
SONIOX_MODEL=stt-rt-v5
SONIOX_WEBSOCKET_URL=wss://stt-rt.soniox.com/transcribe-websocket
SONIOX_MAX_ENDPOINT_DELAY_MS=1500
SONIOX_KEEPALIVE_SECONDS=8
SONIOX_SESSION_RETRY_ATTEMPTS=6
SONIOX_SESSION_RETRY_DELAY_SECONDS=1.0
SONIOX_SESSION_MAX_RETRY_DELAY_SECONDS=8.0
STT_STREAM_CHUNK_MS=100

# Text-to-Speech (TTS) Engine — 100% Free, Unlimited Microsoft Edge Neural Voices
TTS_PROVIDER=edge

# Database Configuration (Optional: automatically uses SQLite if empty)
# DATABASE_URL=postgresql://user:password@host/dbname
