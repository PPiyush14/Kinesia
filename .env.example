APP_LOG_LEVEL=INFO

# AI Engine — Groq Cloud (Ultra-fast LLM translation & Groq Whisper STT)
GEMMA_RESPONSE_BASE_URL=https://api.groq.com/openai/v1
GEMMA_RESPONSE_API_KEY=gsk_your_groq_api_key_here
GEMMA_MODEL=qwen/qwen3.8-27b
GEMMA_TEMPERATURE=0.0
GEMMA_MAX_TOKENS=256
GEMMA_REQUEST_TIMEOUT_SECONDS=30

# Speech-to-Text (STT) Engine
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Text-to-Speech (TTS) Engine — 100% Free, Unlimited Microsoft Edge Neural Voices
TTS_PROVIDER=edge

# Database Configuration (Optional: automatically uses SQLite if empty)
# DATABASE_URL=postgresql://user:password@host/dbname
